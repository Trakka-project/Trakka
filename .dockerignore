.git
.gitignore
*.md
compose.yml
data/
*.db
*.db-wal
*.db-shm
# Only ever supplied explicitly, via --build-context vendor=./vendor (see
# the Dockerfile's vendor stage) — never part of the ordinary context.
vendor/
# Maintainer tooling and docs images — never COPY'd by the Dockerfile
scripts/
docs/
# Android app tooling (docs/MOBILE_BUILD.md), signing key included — never
# part of the server image
android/
Makefile
# Home Assistant integration and its tests (docs/HOME_ASSISTANT.md): installed
# into Home Assistant by HACS, never part of the server image
custom_components/
tests/
hacs.json
