# Settings for the Android app build (android/build.mjs, docs/MOBILE_BUILD.md). Copy this file to
# android/apk.env (git-ignored) to change them. Variables set in the environment, or on the make
# command line, win over this file. Format: KEY=value, one per line, no variable expansion.
#
# No server address here: the APK works with any Trakka server, chosen on the phone.

# Version of the Android app, not of Trakka (the PWA it opens updates itself). Android only
# installs an APK over the existing app if its version code is not lower: raise
# ANDROID_VERSION_CODE for every APK you hand out.
#ANDROID_VERSION_CODE=1
#ANDROID_VERSION_NAME=1.0.0

# Signing key, relative to android/ (keep it under android/: it is the directory mounted into the
# build container). `make apk-keystore` creates signing/trakka.keystore and stores random
# passwords for it in signing/keystore.env, which the build reads by itself.
#ANDROID_KEYSTORE=signing/trakka.keystore
#ANDROID_KEY_ALIAS=trakka
#ANDROID_KEYSTORE_PASSWORD=
#ANDROID_KEY_PASSWORD=
