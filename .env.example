# Example environment configuration for Trakka.
#
# Trakka is env-var-only (see CLAUDE.md, "Config is env-var only") — there is
# no config file. Copy this to `.env` for local `go run`/`docker compose`
# use and fill in real values; `.env` itself is gitignored and must never be
# committed. None of the values below are real credentials.
#
# For `go run ./cmd/server`, export these into your shell (or use a tool
# like `direnv`/`dotenv` to load `.env` automatically — Trakka's own binary
# does not read a `.env` file itself, it only reads the process environment).
# For `docker compose`, pass `--env-file .env` or add `env_file: .env` to the
# `trakka` service in compose.yml.

PORT=8080
DB_PATH=./trakka.db
STATIC_DIR=./static
TEMPLATES_DIR=./templates

# --- OIDC / SSO (all-or-nothing: set all three, or leave all three empty) ---
BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Sessions ---
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=720

# --- Price-drop scanning ---
PRICE_CHECK_INTERVAL_HOURS=24
SCRAPE_INTERVAL=12h

# --- Instance defaults (admin-editable at runtime afterward) ---
INSTANCE_NAME=Trakka
REGISTRATION_OPEN=true

# --- Web Push / VAPID (all-or-nothing: set all three, or leave all three
# empty to disable push notifications entirely). Generate a real pair with
# `trakka -generate-vapid-keys` and paste the output below — never commit
# the real values. The two below are placeholders only, not usable keys.
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:ops@example.com

# --- Task due-date reminders (only used when Web Push is enabled) ---
# APP_TIMEZONE is what a reminder's HH:MM time of day is interpreted in.
APP_TIMEZONE=Europe/Paris
NOTIF_DUE_SCAN_INTERVAL_MINUTES=30

# --- Encrypted WebDAV backups (configured from the admin console) ---
# Set to true to let backups reach a WebDAV server on a private/LAN,
# loopback or Tailscale/CGNAT address (e.g. a Nextcloud on the same network).
# Off by default: only public addresses are dialed (SSRF guard).
BACKUP_WEBDAV_ALLOW_PRIVATE=false
