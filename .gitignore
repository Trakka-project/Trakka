/trakka
/data/
*.db
*.db-wal
*.db-shm

# Secrets — this app is env-var-configured only (see CLAUDE.md), so a local
# .env is the usual place a developer keeps VAPID/OIDC/session secrets for
# `go run`/docker compose; never commit one, or any private key material.
.env
.env.*
!.env.example
*.pem
*.key

# Local-only offline build input (docs/DEPLOYMENT.md, "When the build can't download Go modules")
vendor/

# Maintainer tooling dependencies (scripts/package.json)
node_modules/

# Android app build (docs/MOBILE_BUILD.md): local settings, the signing key
# and its passwords, and the built APK.
/android/apk.env
/android/signing/
/android/out/
*.keystore
*.jks
